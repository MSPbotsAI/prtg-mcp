# Optional overrides — prtg-mcp has no required env vars.
# Authentication is per-request via three request headers, matching MSPbots'
# own stored credential fields for this integration (PRTG's own PRTG-native
# API auth style — no OAuth/token exchange, just static credentials sent
# with every call):
#   X-PRTG-Server-Url — the PRTG core server hostname, e.g. prtg.example.com
#   X-PRTG-Username — the PRTG API user's username
#   X-PRTG-Passhash — the PRTG "passhash" (generated in PRTG's My Account ->
#     API Key page — NOT the literal account password)
# There is no login/token step: every call sends username+passhash as
# query parameters directly. Nothing is cached or persisted across calls.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
